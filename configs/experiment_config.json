{
  "experiment_name": "relgate_issre2026_pilot",
  "venue_target": "ISSRE 2026 Fast Abstracts / Project Highlights",
  "run_profile": "smoke_first_then_full",
  "models": [
    {
      "role": "frontier_closed_commercial",
      "provider_family": "OpenAI",
      "model_id": "openai/gpt-5.5",
      "paper_label": "OpenAI GPT-5.5",
      "fallback_policy": "STOP_IF_UNAVAILABLE"
    },
    {
      "role": "recent_reasoning_closed_commercial",
      "provider_family": "xAI",
      "model_id": "x-ai/grok-4.3",
      "paper_label": "xAI Grok 4.3",
      "fallback_policy": "STOP_IF_UNAVAILABLE"
    },
    {
      "role": "open_weight_low_cost",
      "provider_family": "Meta",
      "model_id": "meta-llama/llama-4-maverick",
      "paper_label": "Llama 4 Maverick",
      "fallback_policy": "STOP_IF_UNAVAILABLE"
    }
  ],
  "modes": ["m0_freeform", "m1_checklist", "m2_evidence_grounded"],
  "temperature": 0,
  "top_p": 1,
  "max_tokens": 1800,
  "hard_budget_usd": 18.0,
  "stop_if_actual_spend_exceeds_usd": 12.0,
  "smoke_cases": ["case_001", "case_010"],
  "full_cases_glob": "case_*.json",
  "unsafe_cases_expected": 9,
  "ready_control_cases_expected": 3,
  "critical_gates": ["G1", "G2", "G3", "G4"],
  "major_gates": ["G5", "G6", "G7"],
  "forbidden_model_families": ["anthropic", "claude"],
  "forbidden_prompt_leak_terms": ["ground_truth", "expected_decision", "seeded_gaps", "correct decision", "unsafe_cases_expected", "ready_control_cases_expected"],
  "run_order": [
    "python3 scripts/preflight.py",
    "python3 src/run_experiment.py --profile smoke --estimate-only",
    "python3 src/run_experiment.py --profile smoke",
    "python3 src/score_results.py --input-dir results/raw_outputs_smoke --output-prefix smoke",
    "MANUAL_REVIEW_SMOKE_RESULTS_BEFORE_FULL_RUN",
    "python3 src/run_experiment.py --profile full",
    "python3 src/score_results.py --input-dir results/raw_outputs --output-prefix full",
    "python3 src/make_tables.py",
    "python3 src/make_figures.py"
  ]
}
