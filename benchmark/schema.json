{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RelGate Change Bundle",
  "type": "object",
  "required": ["case_id", "case_type", "change_summary", "diff_or_config", "service_context", "ground_truth"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^case_\\d{3}$"},
    "case_type": {"type": "string"},
    "change_summary": {"type": "string"},
    "diff_or_config": {"type": "string"},
    "service_context": {"type": "string"},
    "deployment_plan": {"type": "string"},
    "rollback_plan": {"type": "string"},
    "observability_evidence": {"type": "string"},
    "alerting_evidence": {"type": "string"},
    "owner_oncall_evidence": {"type": "string"},
    "slo_reliability_impact": {"type": "string"},
    "blast_radius": {"type": "string"},
    "validation_evidence": {"type": "string"},
    "ground_truth": {
      "type": "object",
      "required": ["expected_decision", "seeded_gaps"],
      "properties": {
        "expected_decision": {"type": "string", "enum": ["READY", "FIX-BEFORE-SHIP"]},
        "seeded_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gate", "description", "severity"],
            "properties": {
              "gate": {"type": "string", "pattern": "^G[1-7]$"},
              "description": {"type": "string"},
              "severity": {"type": "string", "enum": ["critical", "major", "minor"]}
            }
          }
        }
      }
    }
  }
}
